@{
}

@model Villarin_SYSARCH.Models.CurrentSitIn

<div class="ps-5 pe-5 pt-5">
    <h2>Sit-in Feedback for #@Model.SitId</h2>
    @if (string.IsNullOrWhiteSpace(Model.Feedback))
    {
        <form asp-action="SubmitFeedback" method="post">
            <input type="hidden" name="sitId" value="@Model.SitId" />
        
            <div class="form-group">
                <label>Provide your feedback:</label>
                <textarea name="feedbackText" class="form-control" required></textarea>
            </div>
        
            <button type="submit" class="btn btn-success mt-2">Submit Feedback</button>
        </form>
    }
    else
    {
        <div class="alert alert-info">
            <strong>Your previously submitted feedback:</strong>
            <p>@Model.Feedback</p>
        </div>
        <a asp-action="SitInHistory" class="btn btn-secondary">Back to History</a>
    }
</div>