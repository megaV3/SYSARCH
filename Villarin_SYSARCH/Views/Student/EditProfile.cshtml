
@{
    ViewData["Title"] = "EditProfile";
}


@model Villarin_SYSARCH.Models.Account

<form asp-action="EditProfile" asp-controller="Student" method="post" enctype="multipart/form-data" class="row justify-content-center" id="RegistrationForm" style="margin-top: 10px">

    <div class="border-1 rounded card" style="width: 70%; padding: 50px 100px" id="RegisterField">
        <h4 class="margin-bottom-30" style="text-align: center">Edit Student Profile</h4>
        <div class="row d-flex text-center">
            <div class="">
                <img src="~/images/@(Model.ProfilePicture ?? "ccs_logo.png")" id="profilePreview" style="width:90px; height:90px; border-radius:50%;">
            </div>
            <div class="d-flex justify-content-center">
                <input type="file" name="profileImage" class="form-control mt-2" accept="image/*" style="width: 300px" />
            </div>
        </div>

        <div style="">

            <input asp-for="Id" class="form-control margin-top-10" style="width: 200px" />
            <label asp-for="Id" class="form-label">ID Number</label><br />
            <span asp-validation-for="Id" class="text-danger"></span>
        </div>

        <div class="row" style="">
            <div class="col-4">
                <input asp-for="LastName" class="form-control margin-top-10" />
                <label asp-for="LastName" class="form-label">Last Name</label><br />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
            <div class="col-4">
                <input asp-for="FirstName" class="form-control margin-top-10" />
                <label asp-for="FirstName" class="form-label">First Name</label><br />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
            <div class="col">
                <input asp-for="MiddleName" class="form-control margin-top-10" />
                <label asp-for="MiddleName" class="form-label">Middle Name</label><br />
                <span asp-validation-for="MiddleName" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-2" style="">
                <select asp-for="CourseLevel" class="form-control margin-top-10" disabled>
                    <option value="" disabled selected hidden>@Model.CourseLevel</option>
                    <option value="1">1st Year</option>
                    <option value="2">2nd Year</option>
                    <option value="3">3rd Year</option>
                    <option value="4">4th Year</option>
                </select>
                <label asp-for="CourseLevel" class="form-label">Course Level</label><br />
                <span asp-validation-for="CourseLevel" class="text-danger"></span>
            </div>
            <div class="col-6" style="">
                <select asp-for="Course" class="form-control margin-top-10" disabled>
                    <option value="" disabled selected hidden>@Model.Course</option>
                    <option value="BSIT">Bachelor of Science in Information Technology</option>
                    <option value="BSCS">Bachelor of Science in Computer Science</option>
                </select>
                <label asp-for="Course" class="form-label">Course</label><br />
                <span asp-validation-for="Course" class="text-danger"></span>
            </div>
        </div>

        <div style="width: 50%">
            <input asp-for="Email" class="form-control margin-top-10" />
            <label asp-for="Email" class="form-label">Email</label><br />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div style="width: 70%">
            <input asp-for="Address" class="form-control margin-top-10" />
            <label asp-for="Address" class="form-label">Address</label><br />
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>

        <h5 class="margin-bt-10" style="text-align: center">Confirm Registration</h5>

        <div class="row">
            <div class="col">
                <input asp-for="Password" class="form-control margin-top-10" />
                <label asp-for="Password" class="form-label">Password <span id="ast-red">*</span></label><br />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="col">
                <input asp-for="ConfirmPassword" type="password" class="form-control margin-top-10 " />
                <label asp-for="ConfirmPassword" class="form-label">Repeat your password <span id="ast-red">*</span></label><br />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

        </div>

        <!--These input fields are for details of the student that shouldn't be changed with edit profile-->
        <input type="hidden" asp-for="UniqueId" />
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CourseLevel" />
        <input type="hidden" asp-for="Course" />
        <input type="hidden" asp-for="SessionsRemaining" />
        <input type="hidden" asp-for="ProfilePicture" />

        <div class="text-center">
            <button type="submit" class="btn btn-primary mt-5 " style="">
                Edit Profile
            </button>
        </div>
    </div>

</form>