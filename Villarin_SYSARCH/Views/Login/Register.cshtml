
@{
    ViewData["Title"] = "Register";
}

@model Villarin_SYSARCH.Models.Account

<form asp-action="Register" asp-controller="Login" method="post" class="row justify-content-center" id="RegistrationForm">
    <div class="col" style="">
        <a asp-action="Login" asp-controller="Login" class="btn" style="background-color: red; color: white"> BACK</a>
    </div>
    <div class="text-center margin-bt-10" @*style="background-color:rgba(255, 255, 0, 0.5)*@">
        <h3 style="">REGISTRATION</h3>
    </div>
    <div class="border-1 rounded card" style="width: 70%; padding: 50px 100px" id="RegisterField">
        <h4 class="margin-bottom-30" style="text-align: center">Student Information</h4>
        <div style="">
            <input asp-for="Id" class="form-control  margin-top-20" style="width: 200px" />
            <label asp-for="Id" class="form-label">ID <span id="ast-red">*</span></label><br />
            <span asp-validation-for="Id" class="text-danger"></span>
        </div>

        <div class="row" style="">
            <div class="col-4">
                <input asp-for="LastName" class="form-control margin-top-20" />
                <label asp-for="LastName" class="form-label">Last Name <span id="ast-red">*</span></label><br />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
            <div class="col-4">
                <input asp-for="FirstName" class="form-control  margin-top-20" />
                <label asp-for="FirstName" class="form-label">First Name <span id="ast-red">*</span></label><br />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
            <div class="col">
                <input asp-for="MiddleName" class="form-control  margin-top-20" />
                <label asp-for="MiddleName" class="form-label">Middle Name <span id="ast-red">*</span></label><br />
                <span asp-validation-for="MiddleName" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-2" style="">
                <select asp-for="CourseLevel" class="form-control  margin-top-20">
                    <option value="" disabled selected hidden>Select</option>
                    <option value="1">1st Year</option>
                    <option value="2">2nd Year</option>
                    <option value="3">3rd Year</option>
                    <option value="4">4th Year</option>
                </select>
                <label asp-for="CourseLevel" class="form-label">Course Level <span id="ast-red">*</span></label><br />
                <span asp-validation-for="CourseLevel" class="text-danger"></span>
            </div>
            <div class="col-6" style="">
                <select asp-for="Course" class="form-control  margin-top-20">
                    <option value="" disabled selected hidden>Select a course</option>
                    <option value="BSIT">Bachelor of Science in Information Technology</option>
                    <option value="BSCS">Bachelor of Science in Computer Science</option>
                </select>
                <label asp-for="Course" class="form-label">Course <span id="ast-red">*</span></label><br />
                <span asp-validation-for="Course" class="text-danger"></span>
            </div>
        </div>

        <div style="width: 50%">
            <input asp-for="Email" class="form-control  margin-top-20" />
            <label asp-for="Email" class="form-label">Email <span id="ast-red">*</span></label><br />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div style="width: 70%">
            <input asp-for="Address" class="form-control  margin-top-20" />
            <label asp-for="Address" class="form-label">Address <span id="ast-red">*</span></label><br />
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>

        <h5 class="margin-bt-10" style="text-align: center">Confirm Registration</h5>

        <div class="row">
            <div class="col">
                <input asp-for="Password" type="password" autocomplete="new-password" class="form-control  margin-top-20" />
                <label asp-for="Password" class="form-label">Password <span id="ast-red">*</span></label><br />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="col">
                <input asp-for="ConfirmPassword" type="password" class="form-control  margin-top-20 " />
                <label asp-for="ConfirmPassword" class="form-label">Repeat your password <span id="ast-red">*</span></label><br />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

        </div>


        <div class="text-center">
            <button type="submit" class="btn btn-primary mt-5 " style="width: 100px">
                Register
            </button>
        </div>
    </div>

</form>
