
@{
    ViewData["Title"] = "Login";
}

@model Villarin_SYSARCH.ViewModels.LoginViewModel

<div class="justify-content-around" style="display: flex">
    <div class="justify-content-center align-items-center" style="width: 900px; display: flex">
        <img src="~/images/ccs_logo.png" style="width: 600px; height: 600px" />
    </div>
    <div class="container card" style="margin-top: 100px; width: 600px; padding: 50px">
        <span><i>admin id is 123</i></span> <hr />
        <form asp-action="Login" asp-controller="Login" method="post">
            <div class="mb-3">
                <label asp-for="Id" class="form-label">ID Number</label><br />
                <input asp-for="Id" class="form-control" placeholder="Enter a valid id number" />
                <span asp-validation-for="Id" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password</label><br />
                <input asp-for="Password" class="form-control" placeholder="Enter password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="row justify-content-between">
                <div class="col-md-2" style="width: 150px">
                    <input type="checkbox" name="rememberCheck" value="Remember" />
                    <label>Remember me</label>
                </div>
                <div class="col-md-2 text-end" style="width: 150px">
                    <u>Forgot Password?</u>
                </div>
            </div>
            <div class="justify-content-center text-center align-items-center align-content-center" style="display: flex; flex-direction: column">
                <div>
                    <button type="submit" action="" class="btn btn-primary mt-5 " style="width: 100px">
                        Login
                    </button>
                </div>
                @if (ViewBag.IsAccountsEmpty == true)
                    {
                    <div class="text-danger">
                        There are no registered accounts
                    </div>
                    }
                @if (ViewBag.IsLoginSuccessful == false)
                {
                    <div class="text-danger">
                        Username or password is incorrect!
                    </div>
                }
                <div>
                    <span style="font-size: 10px">
                        Don't have an account?
                        <a asp-controller="Registration" asp-action="Index" class="" style="color: red; text-decoration: none"> Register</a>
                    </span>
                </div>
            </div>
        </form>
    </div>
</div>