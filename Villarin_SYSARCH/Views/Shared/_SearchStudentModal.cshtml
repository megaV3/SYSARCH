
@{
    ViewData["Title"] = "_SearchStudentModal";
}

<div id="searchModal" class="modal">
    <div class="modal-content">
        <div>
            <span><b>Search Student</b></span>
            <span class="searchCloseBtn">&times;</span>
        </div>
        <hr />
        <div style="display: flex; justify-content: center">
            <input type="text" class="form-control" style="width: 200px" placeholder="Search..." />
        </div>
        <hr />
        <div style="display: flex; justify-content: end">
            <button type="submit" class="btn btn-primary" style="margin-left: 10px; width: 100px">
                Search
            </button>
        </div>
    </div>
</div>

<script>
    const sitInModal = document.getElementById("sitInModal");
    const sitInOpenBtn = document.getElementById("sitInOpenBtn");
    const sitInCloseBtn = document.querySelector(".sitInCloseBtn");

    // Open modal on click
    sitInOpenBtn.onclick = () => sitInModal.style.display = "block";

    // Close modal on click of the 'x'
    sitInCloseBtn.onclick = () => sitInModal.style.display = "none";

    // Close modal if user clicks anywhere outside the content box
    window.onclick = (event) => {
      if (event.target == sitInModal) {
        sitInModal.style.display = "none";
      }
    };

    const searchModal = document.getElementById("searchModal");
    const searchOpenBtn = document.getElementById("searchOpenBtn");
    const searchCloseBtn = document.querySelector(".searchCloseBtn");

    // Open modal on click
    searchOpenBtn.onclick = () => searchModal.style.display = "block";

    // Close modal on click of the 'x'
    searchCloseBtn.onclick = () => searchModal.style.display = "none";

    // Close modal if user clicks anywhere outside the content box
    window.onclick = (event) => {
      if (event.target == searchModal) {
        searchModal.style.display = "none";
      }
    };
</script>