<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="~/css/personal.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/VillarinLabActivity1.styles.css" asp-append-version="true" />
</head>
<body class="no-space" style=" ">
    <header class="no-space" style="background-color:#054d9c">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light border-bottom box-shadow mb-3 no-margin" >
            <div class="container-fluid text-white">
                <a class="navbar-brand text-white" asp-area="" asp-controller="Student" asp-action="Dashboard">UC CCS Sit-In System</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                    </ul>
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="text-white btn btn-danger" asp-area="" asp-controller="Login" asp-action="Login">Log out</a>
                        </li>
                    </ul>
                </div>
                @*Head for Login and Registration*@
            </div>
        </nav>
    </header>

    <div class="row g-0" style="">
        <div class="col-2 sidebar" style="height: 94vh;background-color: #0077F9">
            <div class="sidebar-user" style="display: flex;">
                @await Component.InvokeAsync("StudentProfile")
                <!--<div class="text-white" style=" padding: 10px">
                    
                    if (Model != null)
                    {
                        <span class="fw-bold">Model.FirstName Model.MiddleName Model.LastName</span>
                        <div class="alert alert-info">
                            <p>Authenticated: User.Identity.IsAuthenticated</p>
                            <p>Auth Type: User.Identity.AuthenticationType</p>
                            <p>Total Claims: User.Claims.Count()</p>
                        </div>

                        <br />
                        <span><i>Student</i></span>
                        
                    }
                </div>-->
            </div>
            <hr />
            <div class="">
                <ul class="sidebar-list small fw-bold">
                    <li class="highlight-box">
                        <a class="text-white" style="text-decoration: none" asp-area="" asp-controller="Student" asp-action="Home">Home</a>
                    </li>
                    <li class="highlight-box">
                        <a class="text-white" style="text-decoration: none" asp-area="" asp-controller="Student" asp-action="ViewRemainingSession">View remaining Session</a>
                    </li>
                    <li class="highlight-box">
                        <a class="text-white" style="text-decoration: none" asp-area="" asp-controller="Student" asp-action="ViewAnnouncements">View Announcement</a>
                    </li>
                    <li class="highlight-box">
                        <a class="text-white" style="text-decoration: none" asp-area="" asp-controller="Student" asp-action="ViewRules">Lab Sitin Rules & Regulation</a>
                    </li>
                    <li class="highlight-box">
                        <a class="text-white" style="text-decoration: none" asp-area="" asp-controller="Student" asp-action="SitInHistory">Sitin History/Feedback</a>
                    </li>
                    <li class="highlight-box">
                        <a class="text-white" style="text-decoration: none" asp-area="" asp-controller="Student" asp-action="Reservation">Reservation</a>
                    </li>
                    <li class="highlight-box">
                        <a class="text-white" style="text-decoration: none" asp-area="" asp-controller="Student" asp-action="Search">Rewards/Points Received</a>
                    </li>
                    <li class="highlight-box">
                        <a class="text-white" style="text-decoration: none" asp-area="" asp-controller="Student" asp-action="Search">Notifications/Alerts</a>
                    </li>
                    <li class="highlight-box">
                        <a class="text-white" style="text-decoration: none" asp-area="" asp-controller="Student" asp-action="EditProfile">Edit Profile</a>
                    </li>
                </ul>
            </div>
        </div>
        <main style=""  role="main" class="ms-3 pb-3 col">
            
            @RenderBody()
        </main>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
