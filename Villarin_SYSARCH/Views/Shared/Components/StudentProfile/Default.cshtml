
@{
    ViewData["Title"] = "Default";
}

@model Villarin_SYSARCH.Models.Account;

@if (Model != null)
{
    <div class="avatar-wrap" style="margin: auto 20px">
        @* This checks if the user has a photo; if not, it shows the CCS logo or a default *@
        <img src="~/images/@(string.IsNullOrEmpty(Model.ProfilePicture) ? "ccs_logo.png" : Model.ProfilePicture)"
             style="width: 50px; height: 50px; border-radius: 50%; object-fit: cover;" />
    </div>
    <div class="text-white" style=" padding: 10px">
        <span class="fw-bold">@Model.FirstName</span>
        <!--<div class="alert alert-info">
                                <p>Authenticated: User.Identity.IsAuthenticated</p>
                                <p>Auth Type: User.Identity.AuthenticationType</p>
                                <p>Total Claims: User.Claims.Count()</p>
                            </div>-->

        <br />
        <span><i>Student</i></span>
    </div>
                        
}
