@model IEnumerable<Villarin_SYSARCH.Models.CurrentSitIn>

<div class="ps-5 pe-5 pt-5">
    <h3 class="mb-3">Quickview Feedbacks</h3>
    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Purpose</th>
                <th>Sit Lab</th>
                <th colspan="2" width="30%">Feedbacks</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                foreach (var sitInRecord in Model)
                {
                    <tr>
                        <td>@sitInRecord.Id</td>
                        <td>@sitInRecord.Name</td>
                        <td>@sitInRecord.Purpose</td>
                        <td>@sitInRecord.Lab</td>
                        <td colspan="2">
                            @if (string.IsNullOrWhiteSpace(sitInRecord.Feedback))
                            {
                                <span class="badge bg-danger">Empty</span>
                            }
                            else
                            {
                                <span>@sitInRecord.Feedback</span>
                            }
                        </td>
                    </tr>
                }

            }
            else
            {
                <tr>
                    <td colspan="8">
                        No data available...
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
