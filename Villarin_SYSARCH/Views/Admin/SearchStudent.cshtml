
@{
    ViewData["Title"] = "SearchStudent";
}

@model Villarin_SYSARCH.ViewModels.SearchDetailsViewModel

<form asp-action="SearchStudent" asp-controller="Admin" method="post" class="row">
    <div class="d-flex col">
        <div class="d-flex col-3 justify-content-center">
            <span><b>Search Student</b></span>
        </div>
        <hr />
        <div class="d-flex col ">
            <input asp-for="SearchId" class="form-control" style="width: 200px" placeholder="Search..." />
            <div asp-validation-summary="All" class="text-danger"></div>
        </div>
        <hr />
        <div class="d-flex col-5 justify-content-center">
            <button type="submit" class="btn btn-primary" style="margin-left: 10px; width: 100px">
                Search
            </button>
        </div>
    </div>
</form>

@if (Model != null && Model.SessionRemaining != 0)
{
    <hr />
    <div class="row">
        <div class="col">
            <span>Id: @Model.Id</span>
        </div>
        <div class="col">
            <span>Name: @Model.Name</span>
        </div>
        <div class="col">
            <span>Year: @Model.CourseLevel</span>
        </div>
        <div class="col">
            <span>Course: @Model.Course</span>
        </div>
        <div class="col">
            <span>Sessions: @Model.SessionRemaining</span>
        </div>

    </div>
}
else if (@ViewBag.isIdFound == false)
{
    <span class="text-danger">Can't find student!</span>
}